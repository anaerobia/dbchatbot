# --- Databases ---
# Multiple databases (Oracle and/or Postgres) are configured in
# backend/databases.json — copy databases.example.json and edit it. Put each
# database's password here and reference it with "password_env" there, e.g.:
# ORACLE_MAIN_PASSWORD=...
# ANALYTICS_PG_PASSWORD=...
# DATABASES_CONFIG=databases.json   # optional: alternate config path

# --- Legacy single-Oracle connection ---
# Used only when backend/databases.json does not exist.
# Read-only user recommended; see README. Do NOT commit real credentials —
# put them in backend/.env (gitignored), not here.
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=your_password
ORACLE_HOST=your-db-host.example.com
ORACLE_PORT=1521
ORACLE_SID=your_sid

# --- LLM provider ---
# anthropic (default) = Claude API (paid, best quality)
# lmstudio            = local model served by LM Studio, or any other
#                       OpenAI-compatible server (Ollama, vLLM, ...). Free.
LLM_PROVIDER=anthropic

# --- Anthropic API (LLM_PROVIDER=anthropic) ---
# Get a key at https://console.anthropic.com/ or run `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- Local / OpenAI-compatible server (LLM_PROVIDER=lmstudio) ---
# LM Studio: Developer tab -> Start Server (default port 1234).
# LLM_MODEL must match the model identifier shown in LM Studio.
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=qwen2.5-coder-14b-instruct
# LLM_API_KEY=lm-studio      # ignored by LM Studio; set for hosted servers
# LLM_TIMEOUT=300            # seconds; local models can be slow

# --- App settings ---
# Max rows fetched from any query (hard cap, enforced in Python).
MAX_ROWS=1000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
