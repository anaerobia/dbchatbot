# --- Oracle connection (read-only user recommended; see README) ---
# Fill these in with your own connection details. Do NOT commit real
# credentials — put them in backend/.env (gitignored), not here.
ORACLE_USER=your_readonly_user
ORACLE_PASSWORD=your_password
ORACLE_HOST=your-db-host.example.com
ORACLE_PORT=1521
ORACLE_SID=your_sid

# --- Anthropic API ---
# Get a key at https://console.anthropic.com/ or run `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# --- App settings ---
# Max rows fetched from any query (hard cap, enforced in Python).
MAX_ROWS=1000
# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
